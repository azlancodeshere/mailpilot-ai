# MailPilot AI — backend environment
# Copy this file to `.env` and fill in real values.

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/mailpilot

# --- CORS -----------------------------------------------------------------
# Origin of the running frontend.
CLIENT_URL=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Generate each with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# --- AI -------------------------------------------------------------------
# Optional. Leave empty to keep the deterministic rule-based classifier
# (the API still works, it just never calls Gemini).
GEMINI_API_KEY=

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
